{
  "id": "com.sampurno.geniewidget",
  "version": "1.0.0",
  "name": "Genie Assistant",
  "description": "SAP Analytics Cloud custom widget for communicating with a Databricks Genie backend.",
  "newInstancePrefix": "GenieAssistant",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-sampurno-geniewidget",
      "url": "https://cdn.jsdelivr.net/gh/sampurno417/GenieWidget/GenieWidget.js",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "backendUrl": {
      "type": "string",
      "description": "URL of the Databricks Flask application",
      "default": ""
    }
  },
  "methods": {
    "askGenie": {
      "description": "Send a natural-language question to Databricks Genie",
      "parameters": [
        {
          "name": "question",
          "type": "string"
        }
      ],
      "returnType": "string"
    },
    "clearChat": {
      "description": "Clear the current chat conversation",
      "parameters": [],
      "returnType": "void"
    },
    "getSessionId": {
      "description": "Get the current Genie session ID",
      "parameters": [],
      "returnType": "string"
    },
    "setBackendUrl": {
      "description": "Set the Databricks backend URL",
      "parameters": [
        {
          "name": "url",
          "type": "string"
        }
      ],
      "returnType": "void"
    },
    "getBackendUrl": {
      "description": "Get the configured Databricks backend URL",
      "parameters": [],
      "returnType": "string"
    }
  },
  "events": {
    "onMessageSent": {
      "description": "Fired when a question is sent to the backend",
      "parameters": [
        {
          "name": "question",
          "type": "string"
        }
      ]
    },
    "onResponseReceived": {
      "description": "Fired when a Genie response is received",
      "parameters": [
        {
          "name": "response",
          "type": "string"
        }
      ]
    },
    "onError": {
      "description": "Fired when an error occurs",
      "parameters": [
        {
          "name": "error",
          "type": "string"
        }
      ]
    }
  }
}